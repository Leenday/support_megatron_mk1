msgstr "Предложил"

msgid "Spelling: the system it belongs to; new system: the one created."
msgstr ""
"Для написания — система, к которой оно относится; для новой системы — "
"созданная система."

msgid "Text"
msgstr "Текст"

msgid "The system's name or the spelling."
msgstr "Название системы или написание."

msgid "Normalised text: similar proposals group by it."
msgstr "Нормализованный текст: по нему группируются похожие предложения."

msgid "Changes"
msgstr "Изменения"

msgid "Field edit: {field: [old, new]}."
msgstr "Правка поля: {поле: [было, стало]}."

msgid "Reviewed by"
msgstr "Проверил"

msgid "Empty with a decision = approved automatically."
msgstr "Пусто при принятом решении = утверждено автоматически."

msgid "proposal"
msgstr "предложение"

msgid "proposals"
msgstr "предложения"

