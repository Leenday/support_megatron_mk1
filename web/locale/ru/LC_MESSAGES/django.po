#, python-format
msgid "Created and routed to “%(department)s”"
msgstr "Создана и направлена в отдел «%(department)s»"

msgid "Taken in progress"
msgstr "Взята в работу"

#, python-format
msgid "Edited: %(fields)s"
msgstr "Изменены поля: %(fields)s"

#, python-format
msgid "Returned from “%(from)s” to “%(to)s”: %(reason)s"
msgstr "Возвращена из отдела «%(from)s» в отдел «%(to)s»: %(reason)s"

#, python-format
msgid "Reassigned from “%(from)s” to “%(to)s”"
msgstr "Переназначена из отдела «%(from)s» в отдел «%(to)s»"

msgid "Done; the department was right"
msgstr "Выполнена; отдел верный"

#, python-format
msgid "Done; it should have gone to “%(department)s”"
msgstr "Выполнена; должна была уйти в отдел «%(department)s»"

msgid "The ticket is yours now."
msgstr "Заявка теперь ваша."

msgid "Changes saved."
msgstr "Изменения сохранены."

#, python-format
msgid "Returned to “%(department)s”."
msgstr "Возвращена в отдел «%(department)s»."

msgid "The ticket is done."
msgstr "Заявка выполнена."

msgid "Choose an active department for the specialist."
msgstr "Выберите действующий отдел для специалиста."

msgid "Fallback"
msgstr "Резервный отдел"

msgid "Send requests here when no other department fits. Selecting this replaces the current fallback."
msgstr "Сюда поступают обращения, для которых не подошёл другой отдел. Выбор заменяет текущий резервный отдел."

msgid "Enter a non-empty JSON list of tags."
msgstr "Введите непустой список тегов в формате JSON."

msgid "Choose a language enabled in routing settings."
msgstr "Выберите язык, включённый в настройках маршрутизации."

msgid "The fallback department must be active."
msgstr "Резервный отдел должен быть активен."

msgid "Select a different fallback department first."
msgstr "Сначала назначьте другой резервный отдел."

msgid "Enter strictly decreasing numbers between 0 and 1, excluding 0."
msgstr "Введите строго убывающие числа больше 0 и не больше 1."

msgid "Enter a JSON list of language codes such as ru and en."
msgstr "Введите список кодов языков в формате JSON, например ru и en."

msgid "Keep all languages used by active departments."
msgstr "Сохраните все языки, используемые активными отделами."

msgid "Describe the problem in your own words"
msgstr "Опишите проблему своими словами"

msgid "Russian or English. Who, where, when and what happened, if you know."
msgstr "На русском или английском. Кто, где, когда и что случилось, если знаете."

msgid "How to reach you"
msgstr "Как с вами связаться"

msgid "E-mail, phone or messenger."
msgstr "E-mail, телефон или мессенджер."

msgid "Status"
msgstr "Статус"

msgid "Any"
msgstr "Любой"

msgid "Tag"
msgstr "Тег"

msgid "From"
msgstr "С"

msgid "To"
msgstr "По"

msgid "Who"
msgstr "Кто"

msgid "Where"
msgstr "Где"

msgid "When"
msgstr "Когда"

msgid "What"
msgstr "Что"

msgid "Summary"
msgstr "Кратко"

msgid "Tags"
msgstr "Теги"

msgid "Separated by commas."
msgstr "Через запятую."

msgid "Why it is not for this department"
msgstr "Почему заявка не для этого отдела"

msgid "Was the department right?"
msgstr "Отдел был выбран верно?"

msgid "Yes"
msgstr "Да"

msgid "No, it should have gone to:"
msgstr "Нет, она должна была уйти в:"

msgid "Department"
msgstr "Отдел"

msgid "Choose a department"
msgstr "Выберите отдел"

msgid "Choose the department that should have got it."
msgstr "Выберите отдел, в который она должна была уйти."

msgid "Requester"
msgstr "Заявитель"

msgid "Specialist"
msgstr "Специалист"

msgid "Administrator"
msgstr "Администратор"

msgid "Specialists only: the department whose tickets they work on."
msgstr "Отдел, с заявками которого работает специалист."

msgid "Department ID"
msgstr "Идентификатор отдела"

msgid "Stable id: the model returns it, and the YAML import matches by it."
msgstr "Постоянный идентификатор. Его возвращает модель, и по нему импорт из YAML находит отдел."

msgid "Name in Russian"
msgstr "Название на русском"

msgid "Name in English"
msgstr "Название на английском"

msgid "Description"
msgstr "Описание"

msgid "The model reads this to choose the department: describe what it handles."
msgstr "Модель читает описание при выборе отдела. Укажите, какие обращения он обрабатывает."

msgid "Keywords, shown to the model as well."
msgstr "Ключевые слова, которые видит модель."

msgid "Language"
msgstr "Язык"

msgid "Language of the department's tickets."
msgstr "Язык заявок отдела."

msgid "Capacity"
msgstr "Ёмкость"

msgid "Open tickets the department can handle at once; empty = load not used."
msgstr "Сколько открытых заявок отдел может обработать одновременно. Пустое значение отключает учёт загрузки."

msgid "Receives requests that fit no other department."
msgstr "Получает обращения, для которых не подошёл другой отдел."

msgid "Active"
msgstr "Активен"

msgid "Inactive departments are not offered to the model."
msgstr "Неактивные отделы не предлагаются модели."

msgid "department"
msgstr "отдел"

msgid "departments"
msgstr "отделы"

msgid "System ID"
msgstr "Идентификатор системы"

msgid "Name"
msgstr "Название"

msgid "Spellings"
msgstr "Варианты написания"

msgid "How requests write it: names, abbreviations, transliterations. The model reads them."
msgstr "Названия, сокращения и транслитерации из обращений. Модель учитывает эти варианты."

msgid "Inactive systems are not offered."
msgstr "Неактивные системы не предлагаются модели."

msgid "system"
msgstr "система"

msgid "systems"
msgstr "системы"

msgid "Profile weight"
msgstr "Вес соответствия профилю"

msgid "Load weight"
msgstr "Вес загрузки"

msgid "Rank scores"
msgstr "Оценки по рангу"

msgid "Profile match of the model's 1st, 2nd, ... candidate, decreasing."
msgstr "Оценки соответствия первого, второго и следующих кандидатов модели по убыванию."

msgid "Ticket languages"
msgstr "Языки заявок"

msgid "ISO 639-1 codes; the first is the default."
msgstr "Коды ISO 639-1. Первый язык используется по умолчанию."

msgid "routing settings"
msgstr "настройки маршрутизации"

msgid "Routing settings"
msgstr "Настройки маршрутизации"

msgid "Request text"
msgstr "Текст обращения"

msgid "Contact"
msgstr "Контакт"

msgid "E-mail, phone or messenger of the requester."
msgstr "Почта, телефон или мессенджер заявителя."

msgid "Created"
msgstr "Создана"

msgid "Model"
msgstr "Модель"

msgid "Prompt version"
msgstr "Версия промпта"

msgid "Attempts"
msgstr "Попытки"

msgid "Dropped identifiers"
msgstr "Удалённые идентификаторы"

msgid "Seconds"
msgstr "Секунды"

msgid "Error"
msgstr "Ошибка"

msgid "Secret part of the requester's status link."
msgstr "Секретная часть ссылки на статус обращения."

msgid "request"
msgstr "обращение"

msgid "request log"
msgstr "журнал обращений"

msgid "New"
msgstr "Новая"

msgid "In progress"
msgstr "В работе"

msgid "Done"
msgstr "Выполнена"

msgid "Request"
msgstr "Обращение"

msgid "Systems"
msgstr "Системы"

msgid "System ids, see System."
msgstr "Идентификаторы из справочника систем."

msgid "Identifiers"
msgstr "Идентификаторы"

msgid "Model's candidates"
msgstr "Кандидаты модели"

msgid "Department ids, best fit first."
msgstr "Идентификаторы отделов в порядке убывания соответствия."

msgid "Assignee"
msgstr "Исполнитель"

msgid "Taken"
msgstr "Взята"

msgid "Closed"
msgstr "Закрыта"

msgid "ticket"
msgstr "заявка"

msgid "tickets"
msgstr "заявки"

msgid "Status changed"
msgstr "Статус изменён"

msgid "Edited"
msgstr "Изменена"

msgid "Returned"
msgstr "Возвращена"

msgid "Reassigned"
msgstr "Переназначена"

msgid "Ticket"
msgstr "Заявка"

msgid "Event type"
msgstr "Тип события"

msgid "Actor"
msgstr "Автор события"

msgid "Empty = the system."
msgstr "Пустое значение означает действие системы."

msgid "Event data"
msgstr "Данные события"

msgid "Event time"
msgstr "Время события"

msgid "ticket event"
msgstr "событие заявки"

msgid "ticket events"
msgstr "события заявок"

msgid "User"
msgstr "Пользователь"

msgid "What the token is for, e.g. the script."
msgstr "Назначение токена, например имя скрипта."

msgid "Hint"
msgstr "Начало токена"

msgid "Start of the token, to tell tokens apart."
msgstr "Первые символы, по которым можно отличить токены."

msgid "Last used"
msgstr "Последнее использование"

msgid "API token"
msgstr "токен API"

msgid "API tokens"
msgstr "токены API"

msgid "Log out"
msgstr "Выйти"

msgid "Export departments to YAML"
msgstr "Выгрузить отделы в YAML"

msgid "You have no department yet, so the queue is empty. Ask an admin to set it."
msgstr "У вас ещё нет отдела, поэтому очередь пуста. Попросите администратора его указать."

msgid "Show"
msgstr "Показать"

msgid "Age"
msgstr "Ждёт"

msgid "Take"
msgstr "Взять в работу"

msgid "Only the oldest 200 are shown: narrow the filters."
msgstr "Показаны только 200 самых старых: уточните фильтры."

msgid "No tickets here."
msgstr "Заявок нет."

#, python-format
msgid "Ticket #%(number)s"
msgstr "Заявка №%(number)s"

#, python-format
msgid "Request #%(number)s"
msgstr "Обращение №%(number)s"

msgid "Sent"
msgstr "Отправлено"

msgid "The ticket becomes yours and moves to In progress."
msgstr "Заявка станет вашей и перейдёт в статус «В работе»."

msgid "Close"
msgstr "Закрыть"

msgid "Mark done"
msgstr "Отметить выполненной"

msgid "Return"
msgstr "Вернуть"

#, python-format
msgid "Not for this department? The ticket goes to “%(department)s” as New."
msgstr "Не для этого отдела? Заявка уйдёт в отдел «%(department)s» как новая."

msgid "Every department has had this ticket; an admin can reassign it."
msgstr "Заявка уже побывала во всех подходящих отделах; переназначить её может администратор."

msgid "Edit the fields"
msgstr "Правка полей"

msgid "Save"
msgstr "Сохранить"

msgid "History"
msgstr "История"

msgid "Log in"
msgstr "Войти"

msgid "Log in for staff"
msgstr "Вход для сотрудников"

msgid "Requesters need no account: use the request form."
msgstr "Заявителям учётная запись не нужна: воспользуйтесь формой обращения."

msgid "Wrong username or password."
msgstr "Неверное имя пользователя или пароль."

msgid "Username"
msgstr "Имя пользователя"

msgid "Password"
msgstr "Пароль"

msgid "New request"
msgstr "Новое обращение"

msgid "Too many requests from your address. Please wait a minute and send it again."
msgstr "Слишком много обращений с вашего адреса. Подождите минуту и отправьте снова."

msgid "Processing…"
msgstr "Обрабатывается…"

msgid "Send"
msgstr "Отправить"

#, python-format
msgid "Ticket #%(number)s accepted, sent to “%(department)s”."
msgstr "Заявка №%(number)s принята и направлена в отдел «%(department)s»."

#, python-format
msgid "Request #%(number)s accepted. A specialist will route it manually."
msgstr "Обращение №%(number)s принято. Специалист распределит его вручную."

msgid "Keep this link to check the status:"
msgstr "Сохраните ссылку, чтобы проверить статус:"

msgid "The request is waiting for a specialist to route it."
msgstr "Обращение ждёт, пока специалист его распределит."

msgid "Send another request"
msgstr "Отправить ещё одно обращение"

msgid "Only the specialist working on the ticket can do this."
msgstr "Это может только специалист, который работает с заявкой."

msgid "The ticket is already taken."
msgstr "Заявку уже взяли в работу."

msgid "A done ticket cannot be returned."
msgstr "Выполненную заявку вернуть нельзя."

msgid "There is no other department to return the ticket to; ask an admin."
msgstr "Вернуть заявку больше некуда; обратитесь к администратору."

msgid "Unknown department."
msgstr "Неизвестный отдел."

msgid "Assignee changed"
msgstr "Исполнитель изменён"

msgid "Enter a finite, non-negative weight."
msgstr "Введите конечное неотрицательное число."

msgid "Choose an active department."
msgstr "Выберите действующий отдел."

msgid "Choose an active specialist from this department."
msgstr "Выберите активного специалиста из этого отдела."
