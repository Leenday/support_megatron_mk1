msgid "Describe the problem in your own words"
msgstr "Опишите проблему своими словами"

msgid "Russian or English. Who, where, when and what happened, if you know."
msgstr ""
"На русском или английском. Кто, где, когда и что случилось, если знаете."

msgid "How to reach you"
msgstr "Как с вами связаться"

msgid "E-mail, phone or messenger."
msgstr "E-mail, телефон или мессенджер."

msgid "New"
msgstr "Новая"

msgid "In progress"
msgstr "В работе"

msgid "Done"
msgstr "Выполнена"

msgid "Support"
msgstr "Поддержка"

msgid "New request"
msgstr "Новое обращение"

msgid ""
"Too many requests from your address. Please wait a minute and send it again."
msgstr ""
"Слишком много обращений с вашего адреса. Подождите минуту и отправьте снова."

msgid "Processing…"
msgstr "Обрабатывается…"

msgid "Send"
msgstr "Отправить"

#, python-format
msgid "Request #%(number)s"
msgstr "Обращение №%(number)s"

#, python-format
msgid "Ticket #%(number)s accepted, sent to “%(department)s”."
msgstr "Заявка №%(number)s принята и направлена в отдел «%(department)s»."

#, python-format
msgid "Request #%(number)s accepted. A specialist will route it manually."
msgstr "Обращение №%(number)s принято. Специалист распределит его вручную."

msgid "Keep this link to check the status:"
msgstr "Сохраните ссылку, чтобы проверить статус:"

msgid "Sent"
msgstr "Отправлено"

msgid "Ticket"
msgstr "Заявка"

msgid "Department"
msgstr "Отдел"

msgid "Status"
msgstr "Статус"

msgid "Taken"
msgstr "Взята"

msgid "Closed"
msgstr "Закрыта"

msgid "The request is waiting for a specialist to route it."
msgstr "Обращение ждёт, пока специалист его распределит."

msgid "Send another request"
msgstr "Отправить ещё одно обращение"
