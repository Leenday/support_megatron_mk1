msgstr "Роль"

msgid "Open tickets"
msgstr "Открытые заявки"

msgid "Load"
msgstr "Загрузка"

msgid "Routing accuracy"
msgstr "Точность маршрутизации"

msgid "Department name"
msgstr "Название отдела"

msgid "Ticket history"
msgstr "История заявки"

