msgstr "Хеш активных систем с вариантами написания на момент обращения."

msgid "Attempts"
msgstr "Попытки"

msgid "Dropped identifiers"
msgstr "Удалённые идентификаторы"

msgid "Seconds"
msgstr "Секунды"

msgid "Error"
msgstr "Ошибка"

