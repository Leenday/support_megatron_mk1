# Copy to .env and fill in. Never commit .env.

# ollama (main, local) or gigachat (backup)
LLM_BACKEND=ollama

# Native Ollama on the host, as seen from the host (uv run megatron ...)
OLLAMA_BASE_URL=http://localhost:11434
# ... and as seen from Docker containers (host Ollama, or a server URL).
# Ollama binds 127.0.0.1:11434 by default; if containers or other machines cannot reach it,
# set OLLAMA_HOST=0.0.0.0:11434 for the Ollama server (see docs.ollama.com/faq).
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# GigaChat authorization key from developers.sber.ru (only for LLM_BACKEND=gigachat)
GIGACHAT_CREDENTIALS=

DEPARTMENTS_PATH=config/departments.yaml
