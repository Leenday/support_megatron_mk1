# Copy to .env and fill in. Never commit .env.

# ollama (local), openai (OpenAI or an OpenAI-compatible API) or gigachat (backup)
LLM_BACKEND=ollama

# Native Ollama on the host, as seen from the host (uv run megatron ...)
OLLAMA_BASE_URL=http://localhost:11434
# ... and as seen from Docker containers. Default: the `ollama` compose service.
# For a native Ollama on the host use http://host.docker.internal:11434, for a server its URL
# (run compose with --no-deps then). Ollama binds 127.0.0.1 by default; set
# OLLAMA_HOST=0.0.0.0:11434 on that machine if it must be reachable (docs.ollama.com/faq).
OLLAMA_BASE_URL_DOCKER=http://ollama:11434
# qwen3:1.7b fits CPU-only Docker; qwen3:8b is the target model with a GPU (compared in #14).
OLLAMA_MODEL=qwen3:1.7b

# Only for LLM_BACKEND=openai. Project key with Restricted permissions (Model capabilities:
# Request, List models: Read) and a spend limit. In Docker run with --no-deps (no Ollama).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Empty = api.openai.com; set for an OpenAI-compatible API (OpenRouter, vLLM, LM Studio, ...)
OPENAI_BASE_URL=

# GigaChat authorization key from developers.sber.ru (only for LLM_BACKEND=gigachat)
GIGACHAT_CREDENTIALS=

DEPARTMENTS_PATH=config/departments.yaml

# Web service (iteration 2). DATABASE_URL empty = SQLite file web/db.sqlite3 (uv run);
# compose sets it to its `db` service. DJANGO_SECRET_KEY is required unless DJANGO_DEBUG=true:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DATABASE_URL=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# JSON list
DJANGO_ALLOWED_HOSTS=["localhost","127.0.0.1"]
POSTGRES_PASSWORD=megatron
